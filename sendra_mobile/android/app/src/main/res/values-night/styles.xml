<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Avant Android 12 : fond vert + icône centrée (drawable/launch_background). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Fond de la fenêtre derrière Flutter : même vert que le splash pour
         éviter tout flash blanc/noir entre le splash et la première image. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/sendra_splash_background</item>
    </style>
</resources>
