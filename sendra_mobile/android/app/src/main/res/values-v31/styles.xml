<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ : splash système. Fond vert SENDRA + icône dédiée
         (drawable/splash_icon, marges incluses pour ne pas être rognée par
         le masque circulaire du système). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/sendra_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowBackground">@color/sendra_splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/sendra_splash_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/sendra_splash_background</item>
    </style>
</resources>
